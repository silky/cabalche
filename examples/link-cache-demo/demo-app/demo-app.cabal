cabal-version:      2.4
name:               demo-app
version:            0.1.0.0
synopsis:           CLI entrypoint for the link-cache demo.
license:            BSD-3-Clause
build-type:         Simple

common opts
  default-language:   Haskell2010
  ghc-options:        -Wall -Wno-unused-imports

executable demo-app
  import:             opts
  hs-source-dirs:     app
  main-is:            Main.hs
  build-depends:      base       >=4.18 && <5
                    , bytestring
                    , demo-codec
                    , demo-core
                    , demo-engine
                    , demo-graph
                    , text
