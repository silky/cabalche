cabal-version:      2.4
name:               demo-core
version:            0.1.0.0
synopsis:           Base types and helpers for the link-cache demo.
license:            BSD-3-Clause
build-type:         Simple

common opts
  default-language:   Haskell2010
  ghc-options:        -Wall -Wno-unused-imports

library
  import:             opts
  hs-source-dirs:     src
  build-depends:      base >=4.18 && <5
  exposed-modules:
      Demo.Core.Path
      Demo.Core.Types
      Demo.Core.Util

test-suite demo-core-test
  import:             opts
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Main.hs
  build-depends:      base
                    , demo-core
                    , tasty
                    , tasty-hunit
